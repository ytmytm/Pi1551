# To show build commands: make V=1
BUILD_RULES := $(lastword $(MAKEFILE_LIST))
ifneq ($(V),1)
Q		:= @
endif

# Pi 3 / Zero 2 W remain the default; Pi 2 BCM2836 is experimental.
# Keep platform objects separate so changing RASPPI never reuses another ISA.
RASPPI	?= 3
PREFIX	?= arm-none-eabi-

CC	= $(PREFIX)gcc
CPP	= $(PREFIX)g++
AS	= $(CC)
LD	= $(PREFIX)ld
AR	= $(PREFIX)ar

ifeq ($(strip $(RASPPI)),3)
	ARCH	?= -march=armv8-a+crc -mtune=cortex-a53 -mfpu=crypto-neon-fp-armv8 -mfloat-abi=hard -marm -mno-unaligned-access -DRPI3=1
	CFLAGS	+= -DRPI3=1
else ifeq ($(strip $(RASPPI)),2)
	ARCH	?= -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -marm -mno-unaligned-access -DRPI2=1
	CFLAGS	+= -DRPI2=1
else
$(error Pi1551 targets are RASPPI=3 (recommended) and RASPPI=2 (experimental BCM2836))
endif

CFLAGS += -DRASPPI=$(RASPPI)
AFLAGS	 += $(ARCH)
CFLAGS	 += $(ARCH) -Wall -Wno-unused-variable -Wno-unused-but-set-variable -Wno-psabi -fsigned-char -fno-builtin -Ofast -DNDEBUG
CPPFLAGS := $(CFLAGS) $(CPPFLAGS) -fno-exceptions -fno-rtti -std=c++0x -Wno-write-strings
CFLAGS	 += -fno-delete-null-pointer-checks -fdata-sections -ffunction-sections -u _printf_float -std=gnu99

.PHONY: clean

$(OBJDIR)/%.o: $(SRCDIR)/%.S $(BUILD_RULES)
	@mkdir -p $(@D)
	@echo "  AS   $@"
	$(Q)$(AS) $(AFLAGS) $(INCLUDE) -c -o $@ $<

$(OBJDIR)/%.o: $(SRCDIR)/%.c $(BUILD_RULES)
	@mkdir -p $(@D)
	@echo "  CC   $@"
	$(Q)$(CC) $(CFLAGS) $(INCLUDE) -MMD -MP -c -o $@ $<

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp $(BUILD_RULES)
	@mkdir -p $(@D)
	@echo "  CPP  $@"
	$(Q)$(CPP) $(CPPFLAGS) $(INCLUDE) -MMD -MP -c -o $@ $<
